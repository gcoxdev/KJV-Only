{
  "name": "kjv-only",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "packageManager": "npm@10.9.4",
  "engines": {
    "node": ">=22.13 <23"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build && node scripts/check-dist.mjs",
    "build:data": "python3 scripts/import_osis_to_sqlite.py --input data-sources/kjv.osis.xml --db .generated/kjv.sqlite --json public/data/kjv.json && npm run build:data-manifest",
    "build:data-manifest": "node scripts/build-kjv-runtime-manifest.mjs",
    "build:concordance": "node scripts/build-concordance-variants.mjs && node --experimental-strip-types scripts/build-study-enrichment.ts --concordance",
    "build:genealogy": "node scripts/build-genealogy-compact.mjs && node --experimental-strip-types scripts/build-study-enrichment.ts --genealogy",
    "build:study-enrichment": "node --experimental-strip-types scripts/build-study-enrichment.ts",
    "build:map-photos": "node scripts/fetch-map-photos.mjs",
    "build:maps": "node scripts/build-map-json.mjs",
    "build:strongs": "node scripts/build-strongs-compact.mjs",
    "build:topics": "node scripts/build-topic-scriptures.mjs",
    "build:topics-index": "node scripts/build-topics-index.mjs",
    "build:all": "npm run build:data && npm run build",
    "typecheck": "tsc -b",
    "lint": "eslint .",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:e2e:release": "PLAYWRIGHT_USE_PREVIEW=1 playwright test",
    "test:watch": "vitest",
    "audit": "npm audit --audit-level=high",
    "check:deps": "npm ls lexical @lexical/code @lexical/link @lexical/list @lexical/react @lexical/rich-text @lexical/selection @lexical/table @lexical/utils yjs",
    "check:dist": "node scripts/check-dist.mjs",
    "preview": "vite preview --host 127.0.0.1"
  },
  "dependencies": {
    "@base-ui/react": "^1.7.0",
    "@fontsource-variable/inter": "^5.2.8",
    "@lexical/code": "0.49.0",
    "@lexical/link": "0.49.0",
    "@lexical/list": "0.49.0",
    "@lexical/react": "0.49.0",
    "@lexical/rich-text": "0.49.0",
    "@lexical/selection": "0.49.0",
    "@lexical/table": "0.49.0",
    "@lexical/utils": "0.49.0",
    "bible-passage-reference-parser": "^4.0.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "leaflet": "^1.9.4",
    "lexical": "0.49.0",
    "lucide-react": "^1.35.0",
    "maplibre-gl": "^6.6.0",
    "next-themes": "^0.4.6",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-leaflet": "^5.0.0-rc.2",
    "react-resizable-panels": "^4.7.1",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.5.0",
    "tw-animate-css": "^1.4.0",
    "yjs": "13.6.32"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.62.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^22.20.1",
    "@types/react": "^19.2.5",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.1.0",
    "@vitest/coverage-v8": "^4.1.11",
    "eslint": "^10.9.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.4",
    "globals": "^17.11.0",
    "shadcn": "^4.19.0",
    "sirv": "^3.0.2",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.68.0",
    "vite": "^8.2.2",
    "vitest": "^4.1.11"
  }
}
