{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "array",
  "items": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "geojson_file": {
        "type": "string",
        "pattern": "^a[0-9a-f]{6}\\.geojson$"
      },
      "translations": {
        "type": "array",
        "items": {
          "type": "string"
        },
        "minItems": 1
      },
      "types": {
        "type": "array",
        "items": {
          "type": "string"
        },
        "minItems": 1
      },
      "verses": {
        "type": "array",
        "items": {
          "type": "string",
          "pattern": "^[1-3]?[A-Z]{2,3}\\.[0-9]+\\.[0-9]+$"
        },
        "minItems": 1
      },
      "modern_names": {
        "type": "array",
        "items": {
          "type": "string"
        }
      },
      "bounds": {
        "type": "array",
        "items": {
          "type": "array",
          "items": {
            "type": "number"
          },
          "minItems": 4,
          "maxItems": 4
        }
      },
      "identifications": {
        "type": "array",
        "minItems": 1,
        "items": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "id",
            "label",
            "geometry_ids"
          ],
          "properties": {
            "id": {
              "type": "string"
            },
            "label": {
              "type": "string",
              "minLength": 1
            },
            "geometry_ids": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {
                "type": "string"
              }
            },
            "confidence": {
              "type": "integer",
              "minimum": 0,
              "maximum": 1000
            }
          }
        }
      }
    },
    "required": [
      "geojson_file",
      "translations",
      "types",
      "verses",
      "modern_names"
    ]
  }
}
